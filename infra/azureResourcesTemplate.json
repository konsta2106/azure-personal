      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations",
      "apiVersion": "2021-08-01",
      "name": "[concat(parameters('apimServiceName'), '/cv/get-certifications')]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apimServiceName'), 'cv')]"
      ],
      "properties": {
        "displayName": "Get All Certifications",
        "method": "GET",
        "urlTemplate": "/certifications",
        "description": "Retrieve all certification entries"
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations",
      "apiVersion": "2021-08-01",
      "name": "[concat(parameters('apimServiceName'), '/cv/get-certification-by-id')]",
      "dependsOn": [
